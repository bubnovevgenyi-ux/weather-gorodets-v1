{
  "name": "Weather Gorodets — Telegram bot",
  "nodes": [
    {
      "id": "2fb0b07b-8bd0-4aad-9c4a-4a9573f8d001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [
        240,
        300
      ],
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "2fb0b07b-8bd0-4aad-9c4a-4a9573f8d002",
      "name": "Normalize Telegram update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Преобразуем /start и callback_query в единый формат.\n// Все остальные сообщения игнорируются.\nconst periods = new Set([\"today\", \"tomorrow\", \"10_days\", \"2_weeks\"]);\nconst output = [];\n\nfor (const item of $input.all()) {\n  const update = item.json ?? {};\n  const message = update.message;\n  const callback = update.callback_query;\n\n  if (\n    typeof message?.text === \"string\" &&\n    /^\\/(start|menu)(?:@\\w+)?(?:\\s|$)/i.test(message.text.trim())\n  ) {\n    output.push({\n      json: {\n        action: \"welcome\",\n        chatId: message.chat.id,\n      },\n    });\n    continue;\n  }\n\n  if (callback && periods.has(callback.data)) {\n    const chatId = callback.message?.chat?.id ?? callback.from?.id;\n    if (chatId !== undefined && callback.id) {\n      output.push({\n        json: {\n          action: \"forecast\",\n          chatId,\n          callbackQueryId: callback.id,\n          period: callback.data,\n        },\n      });\n    }\n  }\n}\n\nreturn output;"
      }
    },
    {
      "id": "2fb0b07b-8bd0-4aad-9c4a-4a9573f8d003",
      "name": "Is start or menu command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f4e064a6-8c50-46b4-b675-13d5baaa0011",
              "leftValue": "={{ $json.action }}",
              "rightValue": "welcome",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
