# Copy this file to .env and replace the value with a generated secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEATHER_API_REFRESH_TOKEN=replace-this-with-a-random-secret

# Optional remote debugging via PyCharm (disabled by default).
PYCHARM_DEBUG=0
PYCHARM_DEBUG_HOST=localhost
PYCHARM_DEBUG_PORT=5678
PYCHARM_DEBUG_SUSPEND=0
